{
  "cli": {
    "version": ">= 16.24.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "sdk-55"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "sdk-55"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "sdk-55"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
